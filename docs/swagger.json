  "info": {
    "title": "Smart Space Booking API",
    "description": "Backend RESTful API untuk Sistem Reservasi Coworking Space - UKK RPL 2026/2027 SMK Telkom Malang",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterMemberDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "password": {
            "type": "string",
            "example": "Secret123!"
          },
          "nama_member": {
            "type": "string",
            "example": "John Doe"
          },
          "instansi": {
            "type": "string",
            "example": "Universitas Indonesia"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Sudirman No. 123, Jakarta"
          },
          "telp": {
            "type": "string",
            "example": "081234567890"
          },
          "foto": {
            "type": "string",
            "example": "member_john.jpg"
          }
        },
        "required": [
          "username",
          "password",
          "nama_member",
          "instansi",
          "alamat",
          "telp"
        ]
      },
      "RegisterAdminSpaceDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin_space1"
          },
          "password": {
            "type": "string",
            "example": "Admin123!"
          },
          "nama_coworking": {
            "type": "string",
            "example": "Moklet Hub Coworking"
          },
          "nama_pemilik": {
            "type": "string",
            "example": "Ahmad Bidin"
          },
          "telp": {
            "type": "string",
            "example": "081298765432"
          }
        },
        "required": [
          "username",
          "password",
          "nama_coworking",
          "nama_pemilik",
          "telp"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "password": {
            "type": "string",
            "example": "Secret123!"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CheckPromoDto": {
        "type": "object",
        "properties": {
          "nama_diskon": {
            "type": "string",
            "example": "DISKONHEMAT20"
          }
        },
        "required": [
          "nama_diskon"
        ]
      },
      "CreateReservasiDto": {
        "type": "object",
        "properties": {
          "id_space": {
            "type": "number",
            "example": 1
          },
          "tanggal_reservasi": {
            "type": "string",
            "example": "2026-08-30"
          },
          "jam_mulai": {
            "type": "string",
            "example": "09:00"
          },
          "durasi_jam": {
            "type": "number",
            "example": 3
          },
          "id_diskon": {
            "type": "number",
            "example": 1
          },
          "kode_promo": {
            "type": "string",
            "example": "DISKONHEMAT20"
          }
        },
        "required": [
          "id_space",
          "tanggal_reservasi",
          "jam_mulai",
          "durasi_jam"
        ]
      },
      "UpdateCoworkingProfileDto": {
        "type": "object",
        "properties": {
          "nama_coworking": {
            "type": "string",
            "example": "Moklet Hub Coworking Space"
          },
          "nama_pemilik": {
            "type": "string",
            "example": "Ahmad Bidin, S.Kom"
          },
          "telp": {
            "type": "string",
            "example": "081298765432"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Telkom No. 1, Malang"
          },
          "deskripsi": {
            "type": "string",
            "example": "Coworking space terbaik di Malang"
          }
        },
        "required": [
          "nama_coworking",
          "nama_pemilik",
          "telp"
        ]
      },
      "CreateMemberAdminDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "user_budi"
          },
          "password": {
            "type": "string",
            "example": "Secret123!"
          },
          "nama_member": {
            "type": "string",
            "example": "Budi Raharjo"
          },
          "instansi": {
            "type": "string",
            "example": "SMK Telkom Malang"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Danau Ranau No. 1, Malang"
          },
          "telp": {
            "type": "string",
            "example": "085712345678"
          },
          "foto": {
            "type": "string",
            "example": "budi_raharjo.jpg"
          }
        },
        "required": [
          "username",
          "password",
          "nama_member",
          "instansi",
          "alamat",
          "telp"
        ]
      },
      "UpdateMemberAdminDto": {
        "type": "object",
        "properties": {
          "nama_member": {
            "type": "string",
            "example": "Budi Raharjo, S.T."
          },
          "instansi": {
            "type": "string",
            "example": "PT Teknologi Hebat"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Danau Ranau No. 2, Malang"
          },
          "telp": {
            "type": "string",
            "example": "085712345678"
          },
          "password": {
            "type": "string",
            "example": "NewSecret123!"
          },
          "foto": {
            "type": "string",
            "example": "budi_new.jpg"
          }
        }
      },
      "CreateSpaceDto": {
        "type": "object",
        "properties": {
          "nama_space": {
            "type": "string",
            "example": "Personal Desk Alpha 01"
          },
          "harga_per_jam": {
            "type": "number",
            "example": 25000
          },
          "tipe": {
            "type": "string",
            "example": "desk",
            "enum": [
              "desk",
              "meeting_room",
              "private_office"
            ]
          },
          "kapasitas": {
            "type": "number",
            "example": 1
          },
          "deskripsi": {
            "type": "string",
            "example": "WiFi 100Mbps, stopkontak, coffee"
          },
          "foto": {
            "type": "string",
            "example": "desk_alpha_01.jpg"
          }
        },
        "required": [
          "nama_space",
          "harga_per_jam",
          "tipe",
          "kapasitas",
          "deskripsi"
        ]
      },
      "UpdateSpaceDto": {
        "type": "object",
        "properties": {
          "nama_space": {
            "type": "string",
            "example": "Personal Desk Alpha 01 (Updated)"
          },
          "harga_per_jam": {
            "type": "number",
            "example": 30000
          },
          "tipe": {
            "type": "string",
            "enum": [
              "desk",
              "meeting_room",
              "private_office"
            ]
          },
          "kapasitas": {
            "type": "number",
            "example": 2
          },
          "deskripsi": {
            "type": "string"
          },
          "foto": {
            "type": "string"
          }
        }
      },
      "CreateDiskonDto": {
        "type": "object",
        "properties": {
          "nama_diskon": {
            "type": "string",
            "example": "PROMOAGUSTUS"
          },
          "persentase_diskon": {
            "type": "number",
            "example": 20
          },
          "tanggal_awal": {
            "type": "string",
            "example": "2026-08-01T00:00:00Z"
          },
          "tanggal_akhir": {
            "type": "string",
            "example": "2026-08-31T23:59:59Z"
          }
        },
        "required": [
          "nama_diskon",
          "persentase_diskon",
          "tanggal_awal",
          "tanggal_akhir"
        ]
      },
      "UpdateDiskonDto": {
        "type": "object",
        "properties": {
          "nama_diskon": {
            "type": "string",
            "example": "PROMOAGUSTUS2026"
          },
          "persentase_diskon": {
            "type": "number",
            "example": 25
          },
          "tanggal_awal": {
            "type": "string",
            "example": "2026-08-01T00:00:00Z"
          },
          "tanggal_akhir": {
            "type": "string",
            "example": "2026-09-15T23:59:59Z"
          }
        }
      },
      "UpdateReservasiStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "disetujui",
            "enum": [
              "belum_dikonfirm",
              "disetujui",
              "aktif",
              "selesai",
              "dibatalkan"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
